
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "app.ts",
    "server.ts",
    "client.ts",
    "prisma.config.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "prisma/generated"
  ]
}
