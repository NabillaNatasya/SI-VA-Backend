{
  "name": "uts-backend-absensi",
  "version": "1.0.0",
  "description": "REST API Sistem Absensi untuk UTS Mini Project Backend menggunakan Express, TypeScript, dan Prisma ORM dengan basis data SQLite",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "node --watch --experimental-strip-types server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "express",
    "prisma",
    "sqlite",
    "rest-api",
    "absensi",
    "uts",
    "nabilla-natasya"
  ],
  "author": "Nabilla Natasya (240160221029)",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}
